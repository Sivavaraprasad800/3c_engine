# ── Secrets & credentials (NEVER commit) ──
.env
.env.local
.env.production
# Keep .env.example — it's a safe template with no real credentials

# ── FAISS binary indexes (large, regenerate from DB) ──
*.faiss
*.pkl

# ── Python cache ──
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Node / frontend build ──
node_modules/
dist/
.vite/

# ── ALL ps1 scripts ──
*.ps1

# ── Packaging cmd files that contain no secrets ──
# (install.cmd and service_install.cmd ARE committed — they're deployment tools)
# nssm/ download dir is local only
nssm/

# ── Scripts subfolders (research/debug/migration — local only) ──
scripts/research/
scripts/debug/
scripts/migration/
# tools are committed (deployment helpers)
# scripts/tools/ is tracked

# ── Result text files ──
*_result.txt
*.txt

# ── Data / snapshots (local) ──
data/
snapshots/
train_images/

# ── SQLite fallback ──
*.db
*.sqlite

# ── OS files ──
.DS_Store
Thumbs.db
.freebuff/

# ── PyInstaller output ──
exe_output/
build_tmp/

# ── Misc ──
d
