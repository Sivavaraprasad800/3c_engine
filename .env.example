# ─── FRS 3C Engine — Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains real credentials.

# ── Tenant Identity (REQUIRED — unique per client site) ─────────────────────
# This is what separates one client's data from another in the shared DB.
# Use lowercase letters/numbers/underscores only. No spaces.
# Examples: zdotapps | factops | client_abc | site_hyderabad
ORG_ID=your_org_name

# ── Database (MySQL / AWS RDS) ───────────────────────────────────────────────
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
AI_MODE=1

# ── Optional: override full DB URL (takes priority over DB_* vars above) ────
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname
